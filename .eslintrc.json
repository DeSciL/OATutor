{
  "root": true,
  "extends": "react-app",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/content-sources/**",
              "@generated/processed-content-pool/*"
            ],
            "message": "Import content from src/content/contentStore, or courses imported at runtime will be missing."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/ProblemPool/**/*.js"
      ],
      "rules": {
        "no-template-curly-in-string": "off",
        "no-useless-escape": "off"
      }
    },
    {
      "files": [
        "src/config/bktParams/*.js"
      ],
      "rules": {
        "no-dupe-keys": "off",
        "no-useless-escape": "off"
      }
    },
    {
      "files": [
        "src/config/skillModel.js"
      ],
      "rules": {
        "no-useless-escape": "off"
      }
    },
    {
      "files": [
        "src/config/coursePlans.js"
      ],
      "rules": {
        "no-useless-escape": "off"
      }
    },
    {
      "files": [
        "src/kas.js"
      ],
      "rules": {
        "no-unreachable": "off"
      }
    },
    {
      "files": [
        "src/content/contentStore.js",
        "src/content/*.test.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
